# API key rahasia. Jangan gunakan awalan NEXT_PUBLIC_ atau VITE_.
SEEDANCE_API_KEY=isi_api_key_dari_penyedia_seedance

# Base URL endpoint task video, termasuk path generations/tasks bila provider mengikuti ModelArk.
SEEDANCE_API_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3/contents/generations/tasks

# Gunakan ID model Seedance 2.0 tepat seperti yang diberikan oleh console/API provider.
SEEDANCE_MODEL=isi_model_id_seedance_2_0

# Wajib diatur untuk membatasi akses ke API berbayar dari situs yang dideploy.
APP_ACCESS_CODE=ganti_dengan_kode_akses_panjang_dan_acak

# Opsional: whitelist host file video, dipisahkan koma, contoh: cdn.provider.example,video.provider.example
# Jika kosong, API tetap memblokir host/IP lokal yang umum.
SEEDANCE_MEDIA_HOSTS=
